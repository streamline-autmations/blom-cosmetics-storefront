{
  "name": "blom-cosmetics-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:promotion && npm run test:cateye && npm run test:shipping && npm run test:categories",
    "test:promotion": "tsx --test src/lib/womensDayPromotion.test.ts",
    "test:cateye": "tsx --test src/lib/catEyeTwoForOffer.test.ts",
    "test:shipping": "tsx --test src/lib/shipping.test.ts",
    "test:categories": "tsx --test src/lib/shopCategories.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "seed:products": "tsx scripts/seed-products.ts"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.7",
    "@supabase/supabase-js": "^2.57.4",
    "@vitejs/plugin-react": "^4.7.0",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.9.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@netlify/functions": "^2.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.18",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.3.0"
  }
